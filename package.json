{
  "name": "siga-backend",
  "version": "1.0.0",
  "description": "1. Clonar el repo: `git clone https://github.com/MAcevedo91/siga-backend.git` 2. Instalar dependencias: `npm install` 3. Copiar `.env.example` a `.env` y pedir credenciales de Supabase al administrador. 4. Levantar servidor: `npm run dev` ..",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/utils/seed.js",
    "seed:reglas": "node src/utils/seedReglas.js",
    "lint": "eslint src/**/*.js",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAcevedo91/siga-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MAcevedo91/siga-backend/issues"
  },
  "homepage": "https://github.com/MAcevedo91/siga-backend#readme",
  "dependencies": {
    "@sentry/node": "^10.63.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.108.1",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "isomorphic-dompurify": "^3.18.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(isomorphic-dompurify|dompurify|@exodus)/)"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 66,
        "functions": 68,
        "lines": 80,
        "statements": 77
      }
    }
  }
}
